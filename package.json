{
  "name": "@local/dsh-mobile-remote",
  "version": "0.1.0",
  "private": true,
  "description": "Phone takeover for DeepSeek Harness: scan a QR code, then list/chat/stop/switch models and answer questions from your phone over an incremental, offline-cached PWA.",
