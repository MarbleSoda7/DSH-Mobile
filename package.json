    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "web",
    "locale",
    "tools",
    "deploy/pc",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "INSTALL.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "MIT"
}
