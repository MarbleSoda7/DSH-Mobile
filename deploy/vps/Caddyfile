# /etc/caddy/Caddyfile —— 8.152.5.127 上的唯一入口
#
# 服务器对公网只开一个端口：7789。所有"服务器自己干的事"都从它进来：
#
#   /api/*          → 分配接口（127.0.0.1:7790），电脑申请端口
#   /tunnel         → 隧道控制通道（127.0.0.1:7791，同进程里的 TunnelServer）
#   /tunnel-data    → 隧道数据通道（同上，每条手机连接一条）
#
# 两条隧道连接都是 WebSocket Upgrade，是长连接，必须关掉缓冲和超时，
# 否则 Caddy 会在空闲一会儿之后把连接掐掉，表现就是手机上「已断开」。
#
# 用户电脑对外的端口是 9000-9019，手机直连，不经过这里。
#
# 历史：以前这里还有一个 handle 兜底转发给 127.0.0.1:7000（frps）。
# 现在客户端改成纯 Node 的 lib/tunnel.js，服务器端没有 frps 了，
# 那个兜底只会把未知路径吐 502，还容易让人误以为隧道是通的——
# 所以直接删掉，路径不认识就老实回 404。

{
	admin off
}

:7789 {
	# 隧道：控制通道与数据通道都是 WebSocket
	handle /tunnel* {
		reverse_proxy 127.0.0.1:7791 {
			flush_interval -1
			transport http {
				read_timeout 0
				write_timeout 0
				dial_timeout 5s
			}
		}
	}

	# 分配接口
	handle /api/* {
		reverse_proxy 127.0.0.1:7790 {
			header_up X-Forwarded-Proto {scheme}
		}
	}

	handle {
		respond "DSH-Mobile gateway. 请用插件生成的二维码地址访问。" 404
	}
}
